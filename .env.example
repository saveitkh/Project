# Copy to .env and fill in for your environment. Never commit real secrets.

# SQLite file path for local/dev. For production, point this at a real
# Postgres/MySQL connection string and change the `provider` in
# prisma/schema.prisma accordingly.
DATABASE_URL="file:./dev.db"

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# Set to "production" when deployed behind HTTPS.
NODE_ENV="development"

# --- Official TikTok API (optional) ---
# This service never uses unofficial/private TikTok APIs. These are left
# blank until a real, officially-provisioned integration exists. Until then
# all LIVE-monitoring features honestly report UNAVAILABLE, and the
# Simulated mode is available for practice/demo without any of these set.
TIKTOK_OFFICIAL_API_BASE_URL=""
TIKTOK_OFFICIAL_API_CLIENT_ID=""
TIKTOK_OFFICIAL_API_CLIENT_SECRET=""
